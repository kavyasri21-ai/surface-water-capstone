    "# Site-level nitrate summary\n",
    "\n",
    "nitrate_site_summary = (\n",
    "    surface_nitrate\n",
    "    .groupby(\"MonitoringLocationID\")\n",
    "    .agg(\n",
    "        Records=(\"Value\", \"count\"),\n",
    "        Mean_Value=(\"Value\", \"mean\"),\n",
    "        Median_Value=(\"Value\", \"median\"),\n",
    "        Max_Value=(\"Value\", \"max\"),\n",
    "        Latitude=(\"Latitude\", \"mean\"),\n",
    "        Longitude=(\"Longitude\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    "    .sort_values(\"Mean_Value\", ascending=False)\n",
    ")\n",
    "\n",
    "display(nitrate_site_summary.head(15))\n",
    "\n",
    "nitrate_site_summary.to_csv(\"surface_nitrate_site_summary.csv\", index=False)\n",
    "surface_clean.to_csv(\"cleaned_surface_water_final.csv\", index=False)\n",
    "\n",
    "print(\"Surface water cleaned file and nitrate summary saved.\")"
