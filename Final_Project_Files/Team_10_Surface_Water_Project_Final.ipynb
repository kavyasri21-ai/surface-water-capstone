   "source": [
    "surface = surface_raw.copy()\n",
    "\n",
    "needed_cols = {\n",
    "    \"MonitoringLocationIdentifier\": \"MonitoringLocationID\",\n",
    "    \"MonitoringLocationName\": \"MonitoringLocationName\",\n",
    "    \"ActivityStartDate\": \"Date\",\n",
    "    \"CharacteristicName\": \"Characteristic\",\n",
    "    \"ResultMeasureValue\": \"Value\",\n",
    "    \"ResultMeasure/MeasureUnitCode\": \"Unit\",\n",
    "    \"ActivityLocation/LatitudeMeasure\": \"Latitude\",\n",
    "    \"ActivityLocation/LongitudeMeasure\": \"Longitude\"\n",
    "}\n",
    "\n",
    "available_cols = {k: v for k, v in needed_cols.items() if k in surface.columns}\n",
    "surface = surface[list(available_cols.keys())].rename(columns=available_cols)\n",
    "\n",
    "surface[\"Date\"] = pd.to_datetime(surface[\"Date\"], errors=\"coerce\")\n",
    "surface[\"Year\"] = surface[\"Date\"].dt.year\n",
    "\n",
    "surface[\"Value\"] = pd.to_numeric(surface[\"Value\"], errors=\"coerce\")\n",
    "surface[\"Latitude\"] = pd.to_numeric(surface[\"Latitude\"], errors=\"coerce\")\n",
    "surface[\"Longitude\"] = pd.to_numeric(surface[\"Longitude\"], errors=\"coerce\")\n",
    "\n",
    "surface[\"Characteristic\"] = surface[\"Characteristic\"].astype(str).str.strip()\n",
    "\n",
    "surface_clean = surface.dropna(subset=[\"Value\", \"Latitude\", \"Longitude\", \"Characteristic\"]).copy()\n",
    "\n",
    "print(\"Cleaned surface water dataset shape:\", surface_clean.shape)\n",
    "print(\"Unique monitoring sites:\", surface_clean[\"MonitoringLocationID\"].nunique())\n",
    "\n",
    "display(surface_clean.head())"
   ]
